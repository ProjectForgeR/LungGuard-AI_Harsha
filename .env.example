# LungGuard AI Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Model Settings
# Path to the final trained Keras model (relative to project root or absolute)
MODEL_PATH=models/LungGuard_AI_Final.keras

# Upload limits (in bytes; 10485760 = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (comma-separated list, or * for all)
CORS_ORIGINS=*
